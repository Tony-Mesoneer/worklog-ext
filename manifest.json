{
  "manifest_version": 3,
  "name": "Worklog",
  "version": "0.4.0",
  "description": "Log worklog Jira nhanh, theo dõi giờ log của team",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Worklog",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "src/sw/index.ts", "type": "module" },
  "side_panel": { "default_path": "src/ui/sidepanel/index.html" },
  "options_page": "src/ui/options/index.html",
  "permissions": ["storage", "sidePanel", "tabs", "alarms"],
  "host_permissions": ["https://api.github.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "commands": {
    "open-sidepanel": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Mở Worklog side panel"
    }
  }
}
